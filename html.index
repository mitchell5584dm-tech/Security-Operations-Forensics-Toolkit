<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RetireSec Workbench - Security Operations & Forensics Toolkit</title>
<meta name="description" content="Free forever offline security toolkit for small businesses that can't afford a $5k audit. Linux Triage, Password Health, Browser Forensics, SMB Audit. Pro $99/yr. Melbourne, FL">
<link rel="icon" href="data:image/png;base64,">
<style>
:root{--navy:#0a1426;--teal:#2ee5c8;--blue:#4da3ff;--bg:#0e1a2f;--card:#15233f}
*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial}
body{background:var(--navy);color:#e6eefc;line-height:1.6}
a{color:var(--blue);text-decoration:none}
header{padding:24px 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1e3358}
header .logo{display:flex;align-items:center;gap:12px;font-weight:800;font-size:20px}
header .logo img{width:44px;height:44px;border-radius:12px}
.btn{background:var(--teal);color:#05101e;padding:12px 20px;border-radius:10px;font-weight:700;display:inline-block}
.btn-outline{border:1px solid #2a426d;padding:12px 20px;border-radius:10px;color:#cfe0ff}
.hero{padding:72px 6% 40px;display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center}
.hero h1{font-size:42px;line-height:1.1;margin-bottom:16px}
.hero p{color:#a9bfdd;font-size:18px;margin-bottom:24px}
.card{background:var(--card);border:1px solid #20365f;border-radius:16px;padding:20px}
.grid{padding:0 6% 40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}
.badge{display:inline-block;background:#12213d;border:1px solid #24406b;border-radius:999px;padding:4px 10px;font-size:12px;color:#8fb6e6;margin:4px 4px 0 0}
pre{background:#0b1730;border:1px solid #1e3358;border-radius:12px;padding:14px;overflow:auto;font-size:13px;color:#b9f5e8}
footer{padding:32px 6%;border-top:1px solid #1e3358;color:#7f9ac0;font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
@media(max-width:900px){.hero{grid-template-columns:1fr}.hero h1{font-size:32px}}
</style>
</head>
